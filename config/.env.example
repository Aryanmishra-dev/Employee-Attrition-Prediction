# Application
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
HOST_PORT=8000
APP_ENABLE_DOCS=true
APP_ALLOWED_HOSTS=*
APP_ALLOWED_ORIGINS=

# Security and API access
SECRET_KEY=your_secret_key_here
API_KEY=your_api_key_here
APP_AUTH_TOKEN=your_auth_token_here
APP_AUTH_USERNAME=your_username_here
APP_AUTH_PASSWORD=your_password_here

# Database and runtime storage
DATABASE_URL=postgresql://your_user:your_password@your_host:5432/your_database
APP_RUNTIME_DATA_DIR=app/data
APP_MAX_UPLOAD_BYTES=2000000
APP_MAX_BATCH_ROWS=5000
APP_MAX_NOTE_CHARS=2000
APP_STORE_RAW_PREDICTION_INPUTS=true

# Model artifacts
MODEL_PATH=app/ml_model/model.pkl
SCALER_PATH=app/ml_model/scaler.pkl
MEDIUM_RISK_THRESHOLD=0.35
HIGH_RISK_THRESHOLD=0.65

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=employee_attrition_prediction

# Render.com deployment
PYTHON_VERSION=3.11.9
RENDER_SERVICE_NAME=employee-attrition-prediction
